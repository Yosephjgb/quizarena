# Copy to .env and edit. Never commit the real .env.
PORT=3000
# Required in production. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
DB_PATH=./data/quizarena.db
# Set to 1 when running behind a reverse proxy (Render, Railway, Fly.io, nginx) so rate limiting sees real IPs
# TRUST_PROXY=1
# AUTH_RATE_MAX=20
# REVEAL_MS=4000

# Used only by "npm run seed"
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
